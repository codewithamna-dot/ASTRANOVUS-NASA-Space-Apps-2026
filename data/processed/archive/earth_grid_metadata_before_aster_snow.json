    },
    "D3_barren": {
      "status": "derived",
      "temporal": "full year 2024 (12 months)",
      "source": "MODIS MOD13C2 v061 NDVI, peak monthly NDVI (inverted percentile). Low NDVI also occurs over bare soil, sand and rock alike. Snow/ice-covered cells are left empty (MODIS flags those pixels), with the reason stored per cell."
    },
    "D4_terrain": {
      "status": "derived",
      "temporal": "static (SRTM 2000; Antarctic DEM 1994-2008)",
      "source": "Relief = P95 minus P5 of ~1 km elevation inside the cell, percentile. North of 60S: NASA SRTMGL30 v002 (LP DAAC documentation is inconsistent about its northern extent, so values north of 60N are of unconfirmed provenance and lower confidence). South of 60S: NSIDC-0422 Antarctic 1 km DEM (ERS-1 radar + ICESat laser, kriged; smoother than SRTM, coverage ends near 86S). Landscape-scale relief only, not rover-scale slope; 30 m SRTM check exists only for top regions."
    },
    "D5_rock": {
      "status": "proxy",
      "temporal": "full year 2024 (12 months)",
      "source": "MODIS MOD11C3 v061 thermal emissivity (bands 29, 31, 32), mean over valid months: delta = mean(E31,E32) minus E29 is larger for silica-rich bare ground; D5 = inverted percentile, so high = silica-poor (mafic, basalt-like). Bare-ground cells only (peak NDVI <= 0.2 and snow <= 20 %). A coarse thermal-infrared composition proxy: NOT rock exposure, NOT mineral identification, NOT lithology (GLiM/EMIT/ASTER GED not integrated)."
    },
    "D6_ice": {
      "status": "proxy",
      "temporal": "full year 2024 (12 months)",
      "source": "MODIS MOD10CM v061 snow cover extent, peak of monthly cell means. A snow-cover proxy; NOT glacier presence, permafrost, ground ice or subsurface water ice. A separate perennial_snow_ice flag (snow >= 50 % in every observed month, >= 6 months) is stored in earth_grid_features.csv and is not part of the score."
    },
    "D7_polar_light": {
      "status": "derived",
      "temporal": "annual climatology",
      "source": "NASA POWER ALLSKY_SFC_SW_DWN seasonal swing. A terrestrial seasonal-insolation proxy; does not reproduce lunar illumination."
    },
    "D8_thermal_swing": {
      "status": "derived",
      "temporal": "full year 2024 (12 months)",
      "source": "MODIS MOD11C3 v061 land-surface-temperature day minus night, mean over valid months, requiring at least 9 of 12 valid months."
    }
