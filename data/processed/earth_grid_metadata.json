 "dimensions": {
  "D1_cold": {
   "status": "derived",
   "temporal": "annual climatology",
   "source": "NASA POWER T2M (2 m AIR temperature, not land-surface temperature), inverted percentile"
  },
  "D2_aridity": {
   "status": "derived",
   "temporal": "annual climatology",
   "source": "NASA POWER PRECTOTCORR, inverted percentile"
  },
  "D3_barren": {
   "status": "derived",
   "temporal": "full year 2024 (12 months)",
   "source": "MODIS MOD13C2 v061 NDVI, peak monthly NDVI (inverted percentile). Low NDVI also occurs over bare soil, sand and rock alike. Snow/ice-covered cells are left empty (MODIS flags those pixels), with the reason stored per cell."
  },
  "D4_terrain": {
   "status": "derived",
   "temporal": "static (SRTM 2000; Antarctic DEM 1994-2008)",
   "source": "Relief = P95 minus P5 of ~1 km elevation inside the cell, percentile. North of 60S: NASA SRTMGL30 v002 (LP DAAC documentation is inconsistent about its northern extent, so values north of 60N are of unconfirmed provenance and lower confidence). South of 60S: NSIDC-0422 Antarctic 1 km DEM (ERS-1 radar + ICESat laser, kriged; smoother than SRTM, coverage ends near 86S). Landscape-scale relief only, not rover-scale slope; 30 m SRTM check exists only for top regions."
  },
  "D5_rock": {
   "status": "proxy",
   "temporal": "static (ASTER GED v4.1, July 2014 monthly file)",
   "source": "NASA ASTER Global Emissivity Dataset v4.1 (AG5KMMOH): silicate contrast = mean(E13,E14) - mean(E10,E11,E12) over bare, land, non-gap-filled 0.05 deg pixels; D5 = inverted percentile, so high = silica-poor (mafic, basalt-like). A thermal-infrared surface-composition proxy for bare ground only: NOT rock exposure, NOT mineral identification, NOT lithology (GLiM and EMIT not integrated). MODIS MOD11C3 emissivity is kept as an independent cross-check."
  },
  "D6_ice": {
   "status": "proxy",
   "temporal": "multi-year monthly climatology 2015-2024 (10 years)",
   "source": "MODIS MOD10CM v061 snow cover extent, mean of the monthly snow cover over all observed months of the 2015-2024 climatology (percentile-ranked). A snow-cover duration/extent proxy; NOT glacier presence, permafrost, ground ice or subsurface water ice. Polar-night months are unobserved and excluded from the mean (bounding them as 0 or 100 changes the cell ordering very little, Spearman 0.99). A separate perennial_snow_ice flag (snow >= 50 % in every observed month, >= 6 months) is stored in earth_grid_features.csv and is not part of the score. Until 2026-11-16 D6 was the PEAK monthly snow cover, which saturated."
  },
  "D7_polar_light": {
   "status": "derived",
   "temporal": "annual climatology",
   "source": "NASA POWER ALLSKY_SFC_SW_DWN seasonal swing. A terrestrial seasonal-insolation proxy; does not reproduce lunar illumination."
  },
  "D8_thermal_swing": {
   "status": "derived",
   "temporal": "full year 2024 (12 months)",
   "source": "MODIS MOD11C3 v061 land-surface-temperature day minus night, mean over valid months, requiring at least 9 of 12 valid months."
  }
 },
