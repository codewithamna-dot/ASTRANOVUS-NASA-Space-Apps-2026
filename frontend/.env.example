# Base URL of the ASTRANOVUS FastAPI service.
# Dev default: "/api" (proxied by Vite to http://localhost:8000, see vite.config.ts).
# Production example: https://your-api-host.example.com
VITE_API_URL=/api
# Optional: where the dev proxy forwards /api (default http://localhost:8000)
# VITE_DEV_API_TARGET=http://localhost:8000
